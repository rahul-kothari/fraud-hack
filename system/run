#!/bin/sh
# Usage: system/run <data folder> <output file>
# Reads only the data folder; writes one JSON line per hit (see system/README.md).
set -e
HERE=$(cd "$(dirname "$0")" && pwd)
PY=""
for c in python3 python; do
  if "$c" -c "import sys; sys.exit(sys.version_info < (3, 9))" >/dev/null 2>&1; then PY=$c; break; fi
done
[ -n "$PY" ] || { echo "system/run needs Python 3.9 or later" >&2; exit 1; }
# a fixed hash seed so set and dict ordering, and so every result, is the same on every run
PYTHONHASHSEED=0 PYTHONUTF8=1 exec "$PY" "$HERE/run.py" "$@"
